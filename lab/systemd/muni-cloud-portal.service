[Unit]
Description=MUNI-CLOUD Pilot Portal - VM baseline only
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=muni-lab
Group=muni-lab
WorkingDirectory=/opt/muni-cloud
Environment=PORT=8080
Environment=HOST=127.0.0.1
ExecStart=/usr/bin/python3 /opt/muni-cloud/app/server.py
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
